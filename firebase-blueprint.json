{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "University official circulars and announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 240 },
        "category": { "type": "string", "enum": ["admission", "academic", "examination", "administrative", "general"] },
        "publishDate": { "type": "string", "minLength": 3, "maxLength": 60 },
        "content": { "type": "string", "minLength": 3, "maxLength": 5000 },
        "important": { "type": "boolean" },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "publishDate", "content", "important", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Campus gallery photographs and archives",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "category": { "type": "string", "enum": ["campus", "academic", "events", "seminar", "sports", "cultural", "international", "student_life"] },
        "imageUrl": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "caption": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "imageUrl", "caption", "date", "createdAt", "updatedAt"]
    },
    "PortalUser": {
      "title": "PortalUser",
      "description": "University student, faculty, and admin portal accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "role": { "type": "string", "enum": ["student", "guardian", "faculty", "hod", "exam_controller", "admission_officer", "accounts", "officer", "admin"] },
        "category": { "type": "string", "enum": ["student", "teacher"] },
        "department": { "type": "string", "maxLength": 150 },
        "designation": { "type": "string", "maxLength": 150 },
        "password": { "type": "string", "minLength": 4, "maxLength": 128 },
        "status": { "type": "string", "enum": ["Active", "Suspended", "Pending Approval"] },
        "createdAt": { "type": "string", "maxLength": 80 },
        "lastLogin": { "type": "string", "maxLength": 80 },
        "isAdmin": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "category", "department", "password", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Portal authentication audit trail records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Success", "Failed (Wrong Password)", "Failed (Suspended)"] },
        "ipDevice": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "email", "role", "category", "timestamp", "status", "ipDevice", "createdAt"]
    },
    "AdmissionApplication": {
      "title": "AdmissionApplication",
      "description": "Online admission applications submitted by prospective students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trackingNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "applicantName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "fatherName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "motherName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "dateOfBirth": { "type": "string", "maxLength": 40 },
        "gender": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "programId": { "type": "string", "minLength": 2, "maxLength": 100 },
        "programName": { "type": "string", "maxLength": 200 },
        "semester": { "type": "string", "maxLength": 60 },
        "shift": { "type": "string", "maxLength": 40 },
        "sscRoll": { "type": "string", "maxLength": 40 },
        "sscBoard": { "type": "string", "maxLength": 60 },
        "sscGpa": { "type": "string", "maxLength": 20 },
        "sscYear": { "type": "string", "maxLength": 20 },
        "hscRoll": { "type": "string", "maxLength": 40 },
        "hscBoard": { "type": "string", "maxLength": 60 },
        "hscGpa": { "type": "string", "maxLength": 20 },
        "hscYear": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "minLength": 3, "maxLength": 400 },
        "guardianPhone": { "type": "string", "maxLength": 40 },
        "quotaCategory": { "type": "string", "maxLength": 100 },
        "submittedAt": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Received", "Under Review", "Test Scheduled", "Admitted", "Waitlisted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "trackingNumber", "applicantName", "email", "phone", "programId", "sscGpa", "hscGpa", "address", "status", "submittedAt", "createdAt", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inquiries submitted via university contact forms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 150 },
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 40 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "minLength": 3, "maxLength": 3000 },
        "status": { "type": "string", "enum": ["New", "In Progress", "Resolved"] },
        "submittedAt": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "subject", "message", "status", "submittedAt", "createdAt", "updatedAt"]
    },
    "CmsMeta": {
      "title": "CmsMeta",
      "description": "Cloud CMS baseline synchronization state",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seeded", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Verified administrator UID registry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "grantedAt"]
    }
  },
  "firestore": {
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Published university circulars and notices synced in real time across clients"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Campus photographic archives and activity gallery synced in real time"
    },
    "/portalUsers/{userId}": {
      "schema": { "$ref": "#/entities/PortalUser" },
      "description": "Portal user directory strictly protected for Admin and account owner access"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Authentication audit trail accessible only to administrators"
    },
    "/admissions/{admissionId}": {
      "schema": { "$ref": "#/entities/AdmissionApplication" },
      "description": "Submitted student admission applications"
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Submitted visitor and prospective student contact inquiries"
    },
    "/cmsMeta/{metaId}": {
      "schema": { "$ref": "#/entities/CmsMeta" },
      "description": "Publicly readable CMS cloud initialization flag"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Administrator registry for RBAC checks"
    }
  }
}
